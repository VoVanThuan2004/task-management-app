# ===============================
# 🌍 GLOBAL IGNORE
# ===============================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node modules (cả backend & frontend)
node_modules/

# Build outputs
dist/
build/
coverage/
*.tsbuildinfo

# Temporary files


tmp/
temp/
.cache/
.parcel-cache/
.npm/
.eslintcache

# ===============================
# ⚙️ BACKEND (ExpressJS)
# ===============================

# Uploads (nếu có thư mục lưu file upload)
uploads/
public/uploads/
backend/uploads/

# PM2 logs
pids
*.pid
*.seed
*.pid.lock

# MongoDB dump
dump/
*.bak

# Production build (nếu có)
backend/dist/
backend/build/

# ===============================
# 💻 FRONTEND (React + Vite)
# ===============================

# Local Vite cache
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env

# Mac / Windows generated
frontend/.DS_Store
frontend/Thumbs.db

# Build output (Vite)
frontend/.cache/
frontend/.parcel-cache/

# ===============================
# 🧪 TEST / COVERAGE
# ===============================

coverage/
__tests__/
jest.config.js
*.spec.js
*.test.js

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/

